import re
import tkinter as tk

STRENGTHS = [
    {"label": "Very Weak", "color": "#ff4d4d", "width": 0.20},
    {"label": "Weak", "color": "#ff944d", "width": 0.40},
    {"label": "Moderate", "color": "#ffd11a", "width": 0.60},
    {"label": "Strong", "color": "#99cc33", "width": 0.80},
    {"label": "Very Strong", "color": "#33cc33", "width": 1.00},
]

BAR_WIDTH = 272
BAR_HEIGHT = 8


def check_strength(*args):
    val = password_var.get()
    if not val:
        canvas.coords(meter_bar, 0, 0, 0, BAR_HEIGHT)
        feedback_label.config(text="")
        return

    score = 0
    if len(val) >= 8:
        score += 1
    if re.search(r"[a-z]", val):
        score += 1
    if re.search(r"[A-Z]", val):
        score += 1
    if re.search(r"[0-9]", val):
        score += 1
    if re.search(r"[_@$!%*?&#]", val):
        score += 1

    index = max(1, score) - 1
    level = STRENGTHS[index]

    fill_width = int(BAR_WIDTH * level["width"])
    canvas.coords(meter_bar, 0, 0, fill_width, BAR_HEIGHT)
    canvas.itemconfig(meter_bar, fill=level["color"])
    feedback_label.config(text=level["label"], fg=level["color"])


# Main Window Setup
root = tk.Tk()
root.title("Password Strength Meter")
root.geometry("400x260")
root.configure(bg="#f0f2f5")
root.resizable(False, False)

# Card Frame
card = tk.Frame(
    root,
    bg="white",
    padx=24,
    pady=24,
    highlightbackground="#dcdcdc",
    highlightthickness=1,
)
card.place(relx=0.5, rely=0.5, anchor="center", width=320)

# Heading
title_label = tk.Label(
    card,
    text="Check Password Strength",
    font=("Arial", 13, "bold"),
    bg="white",
    fg="#222222",
)
title_label.pack(pady=(0, 14))

# Password Entry
password_var = tk.StringVar()
password_var.trace_add("write", check_strength)

password_entry = tk.Entry(
    card,
    textvariable=password_var,
    show="*",
    font=("Arial", 12),
    relief="solid",
    bd=1,
)
password_entry.pack(fill="x", ipady=5)
password_entry.focus()

# Meter Progress Bar
canvas = tk.Canvas(
    card,
    width=BAR_WIDTH,
    height=BAR_HEIGHT,
    bg="#e0e0e0",
    highlightthickness=0,
)
canvas.pack(pady=(12, 0))
meter_bar = canvas.create_rectangle(0, 0, 0, BAR_HEIGHT, fill="#ff4d4d", width=0)

# Text Feedback
feedback_label = tk.Label(
    card,
    text="",
    font=("Arial", 10, "bold"),
    bg="white",
    anchor="e",
)
feedback_label.pack(fill="x", pady=(8, 0))

root.mainloop()
